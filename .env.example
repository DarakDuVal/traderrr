# Traderrr — Environment Configuration
# Copy to .env and fill in your actual values.
# All variables are loaded by Pydantic BaseSettings in backend/config/settings.py

# ── Database ──────────────────────────────────────────────────────────────────
# Production: PostgreSQL via Supabase (asyncpg driver for FastAPI)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/traderrr

# Supabase (production only — leave blank for local Docker Postgres)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=<service_role_key>

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-minimum-32-chars-high-entropy

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Signal generation ─────────────────────────────────────────────────────────
MIN_CONFIDENCE=0.6
MOMENTUM_THRESHOLD=60.0
MEAN_REVERSION_THRESHOLD=70.0
UPDATE_INTERVAL_MINUTES=30

# ── Risk management ───────────────────────────────────────────────────────────
MAX_POSITION_SIZE=0.20
MAX_SECTOR_CONCENTRATION=0.40
VAR_CONFIDENCE=0.95
MAX_CORRELATION=0.70
VOLATILITY_LIMIT=0.25

# ── Portfolio ─────────────────────────────────────────────────────────────────
REBALANCE_THRESHOLD=0.05

# ── Notifications ─────────────────────────────────────────────────────────────
ALERT_THRESHOLD=0.8
EMAIL_ENABLED=false
EMAIL_ADDRESS=
